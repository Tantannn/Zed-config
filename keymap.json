[
  {
    "context": "Workspace",
    "bindings": {
      "alt-c": "pane::CloseActiveItem",
      "alt-p": "pane::TogglePinTab",
      "ctrl-1": ["pane::ActivateItem", 0],
      "ctrl-2": ["pane::ActivateItem", 1],
      "ctrl-3": ["pane::ActivateItem", 2],
      "ctrl-4": ["pane::ActivateItem", 3],
      "ctrl-5": ["pane::ActivateItem", 5],
      "ctrl-6": ["pane::ActivateItem", 6],
      "ctrl-7": ["pane::ActivateItem", 7],
      "ctrl-8": ["pane::ActivateItem", 8],
      "ctrl-9": ["pane::ActivateItem", 9],
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "ctrl-h": "editor::MoveLeft",
      "ctrl-l": "editor::MoveRight",
      "ctrl-k": "editor::MoveUp",
      "ctrl-j": "editor::MoveDown",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "g r": "editor::FindAllReferences",
      "shift-k": "editor::Hover",
      "Y": ["workspace::SendKeystrokes", "y $"],
      "-": "project_panel::ToggleFocus",
      "tab": "workspace::ActivateNextPane",
      "shift-tab": "workspace::ActivatePreviousPane",
      "space o": ["workspace::SendKeystrokes", "o escape"],
      "space g v": "git::ViewUnstagedChanges",
      "ctrl-w o": "pane::CloseOtherItems",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "g s": "vim::PushAddSurrounds",
      "J": "editor::MoveLineDown",
      "K": "editor::MoveLineUp",
      "space p": ["workspace::SendKeystrokes", "\" _ d P"],
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "-": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-f": "buffer_search::Deploy",
      "alt-a": "editor::SelectAll",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "o": "project_panel::NewFile",
      "shift-o": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Trash",
      "c": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
    },
  },
]
