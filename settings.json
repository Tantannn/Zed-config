// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_project_panel": true,
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "update_debounce_ms": 350,
      "enabled": true,
    },
  },
  "autosave": "on_window_change",
  "diff_view_style": "split",
  "git_panel": {
    "tree_view": false,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 7,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "icon_theme": "Catppuccin Macchiato",
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "buffer_font_size": 13,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "centered_layout": {
    "left_padding": 0.05,
    "right_padding": 0.05,
  },
  "gutter": {
    "min_line_number_digits": 1,
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
        "args": ["--login"],
      },
    },
  },
}
